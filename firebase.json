{
  "functions": {
    "source": "./functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/functions/**",
        "function": {
          "region": "us-central1",
          "functionName": "**"
        }
      }
    ]
  }
}
